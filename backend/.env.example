# Copy to .env and adjust as needed.
# Optional: create .env in backend/ and set these.

# Max upload size in bytes (default 10 MB)
# MAX_FILE_SIZE=10485760

# Directory for temporary uploads and translated files (created if missing)
# TEMP_DIR=temp_uploads

# CORS: comma-separated origins for the frontend (e.g. React dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
